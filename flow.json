[
    {
        "id": "flow_vinicola",
        "type": "tab",
        "label": "Vinícola IoT - CP1",
        "disabled": false,
        "info": "Fluxo principal: MQTT → MySQL + Dashboard + OpenWeather"
    },
    {
        "id": "mqtt_in_telemetria",
        "type": "mqtt in",
        "z": "flow_vinicola",
        "name": "MQTT Telemetria",
        "topic": "vinicola/cp1/telemetria",
        "qos": "1",
        "datatype": "json",
        "broker": "mqtt_broker_config",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
        "x": 130,
        "y": 200,
        "wires": [
            [
                "parse_json"
            ]
        ]
    },
    {
        "id": "parse_json",
        "type": "json",
        "z": "flow_vinicola",
        "name": "Parse JSON",
        "property": "payload",
        "action": "obj",
        "pretty": false,
        "x": 340,
        "y": 200,
        "wires": [
            [
                "insert_mysql",
                "gauge_temp",
                "gauge_umid",
                "gauge_luz",
                "chart_temp_fn",
                "chart_umid_fn",
                "check_alerta"
            ]
        ]
    },
    {
        "id": "insert_mysql",
        "type": "function",
        "z": "flow_vinicola",
        "name": "Preparar INSERT",
        "func": "const d = msg.payload;\nmsg.topic = 'INSERT INTO telemetria (dispositivo, temperatura, umidade, luminosidade, alerta, msg_id, uptime_s) VALUES (?, ?, ?, ?, ?, ?, ?)';\nmsg.payload = [\n    d.dispositivo  || 'esp32_vinicola_cp1',\n    d.temperatura  || 0,\n    d.umidade      || 0,\n    d.luminosidade || 0,\n    d.alerta       || 'ok',\n    d.msg_id       || 0,\n    d.uptime_s     || 0\n];\nreturn msg;",
        "outputs": 1,
        "x": 570,
        "y": 120,
        "wires": [
            [
                "mysql_node"
            ]
        ]
    },
    {
        "id": "mysql_node",
        "type": "mysql",
        "z": "flow_vinicola",
        "mydb": "mysql_config",
        "name": "MySQL INSERT",
        "x": 780,
        "y": 120,
        "wires": [
            [
                "debug_mysql"
            ]
        ]
    },
    {
        "id": "debug_mysql",
        "type": "debug",
        "z": "flow_vinicola",
        "name": "Debug MySQL",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "true",
        "targetType": "full",
        "statusVal": "",
        "statusType": "auto",
        "x": 980,
        "y": 120,
        "wires": []
    },
    {
        "id": "gauge_temp",
        "type": "function",
        "z": "flow_vinicola",
        "name": "Extrair Temperatura",
        "func": "msg.payload = msg.payload.temperatura;\nreturn msg;",
        "outputs": 1,
        "x": 580,
        "y": 200,
        "wires": [
            [
                "ui_gauge_temp"
            ]
        ]
    },
    {
        "id": "gauge_umid",
        "type": "function",
        "z": "flow_vinicola",
        "name": "Extrair Umidade",
        "func": "msg.payload = msg.payload.umidade;\nreturn msg;",
        "outputs": 1,
        "x": 580,
        "y": 260,
        "wires": [
            [
                "ui_gauge_umid"
            ]
        ]
    },
    {
        "id": "gauge_luz",
        "type": "function",
        "z": "flow_vinicola",
        "name": "Extrair Luminosidade",
        "func": "msg.payload = msg.payload.luminosidade;\nreturn msg;",
        "outputs": 1,
        "x": 580,
        "y": 320,
        "wires": [
            [
                "ui_gauge_luz"
            ]
        ]
    },
    {
        "id": "chart_temp_fn",
        "type": "function",
        "z": "flow_vinicola",
        "name": "Temperatura p/ Chart",
        "func": "msg.topic = 'Temperatura';\nmsg.payload = msg.payload.temperatura;\nreturn msg;",
        "outputs": 1,
        "x": 580,
        "y": 380,
        "wires": [
            [
                "ui_chart_historico"
            ]
        ]
    },
    {
        "id": "chart_umid_fn",
        "type": "function",
        "z": "flow_vinicola",
        "name": "Umidade p/ Chart",
        "func": "msg.topic = 'Umidade';\nmsg.payload = msg.payload.umidade;\nreturn msg;",
        "outputs": 1,
        "x": 580,
        "y": 440,
        "wires": [
            [
                "ui_chart_historico"
            ]
        ]
    },
    {
        "id": "check_alerta",
        "type": "switch",
        "z": "flow_vinicola",
        "name": "Tem Alerta?",
        "property": "payload.alerta",
        "rules": [
            {
                "t": "neq",
                "v": "ok",
                "vt": "str"
            }
        ],
        "outputs": 1,
        "x": 570,
        "y": 500,
        "wires": [
            [
                "notificar_alerta"
            ]
        ]
    },
    {
        "id": "notificar_alerta",
        "type": "function",
        "z": "flow_vinicola",
        "name": "Formatar Alerta",
        "func": "const d = msg.payload;\nmsg.payload = `ALERTA: ${d.alerta} | Temp: ${d.temperatura}°C | Umid: ${d.umidade}% | Luz: ${d.luminosidade}`;\nreturn msg;",
        "outputs": 1,
        "x": 780,
        "y": 500,
        "wires": [
            [
                "ui_notificacao"
            ]
        ]
    },
    {
        "id": "ui_notificacao",
        "type": "ui-notification",
        "z": "flow_vinicola",
        "ui": "ui_base",
        "position": "top right",
        "colorDefault": true,
        "color": "#ff0000",
        "displayTime": "5",
        "showCountdown": true,
        "outputs": 1,
        "allowDismiss": true,
        "raw": false,
        "name": "Alerta Vinícola",
        "x": 990,
        "y": 500,
        "wires": [
            []
        ]
    },
    {
        "id": "inject_openweather",
        "type": "inject",
        "z": "flow_vinicola",
        "name": "A cada 10 min",
        "props": [
            {
                "p": "payload"
            },
            {
                "p": "topic",
                "vt": "str"
            }
        ],
        "repeat": "600",
        "crontab": "",
        "once": true,
        "onceDelay": "5",
        "topic": "",
        "payload": "",
        "payloadType": "str",
        "x": 140,
        "y": 620,
        "wires": [
            [
                "http_openweather"
            ]
        ]
    },
    {
        "id": "http_openweather",
        "type": "http request",
        "z": "flow_vinicola",
        "name": "OpenWeather API",
        "method": "GET",
        "ret": "obj",
        "paytoqs": "ignore",
        "url": "https://api.openweathermap.org/data/2.5/weather?q=Sao+Paulo,BR&appid=eaf73f155d8c5eb66e49073923521337&units=metric&lang=pt_br",
        "tls": "",
        "persist": false,
        "proxy": "",
        "insecureHTTPParser": false,
        "authType": "",
        "senderr": false,
        "headers": [],
        "x": 360,
        "y": 620,
        "wires": [
            [
                "parse_weather",
                "4edc405b547d01db"
            ]
        ]
    },
    {
        "id": "parse_weather",
        "type": "function",
        "z": "flow_vinicola",
        "name": "Parse Weather",
        "func": "const w = msg.payload;\nif (!w || !w.main) {\n    node.warn('Resposta inválida do OpenWeather');\n    return null;\n}\nmsg.weather = {\n    cidade:      w.name || 'Sao Paulo',\n    temp_ext:    w.main.temp,\n    umidade_ext: w.main.humidity,\n    descricao:   w.weather[0].description || ''\n};\nmsg.topic = 'INSERT INTO clima_externo (cidade, temp_externa, umidade_ext, descricao) VALUES (?, ?, ?, ?)';\nmsg.payload = [\n    msg.weather.cidade,\n    msg.weather.temp_ext,\n    msg.weather.umidade_ext,\n    msg.weather.descricao\n];\nreturn msg;",
        "outputs": 1,
        "x": 580,
        "y": 620,
        "wires": [
            [
                "mysql_weather",
                "ui_weather_display",
                "4dc55c517fc8f5b0"
            ]
        ]
    },
    {
        "id": "mysql_weather",
        "type": "mysql",
        "z": "flow_vinicola",
        "mydb": "mysql_config",
        "name": "MySQL Weather",
        "x": 790,
        "y": 590,
        "wires": [
            []
        ]
    },
    {
        "id": "ui_weather_display",
        "type": "function",
        "z": "flow_vinicola",
        "name": "Weather p/ Dashboard",
        "func": "const w = msg.weather;\nmsg.payload = `${w.cidade}: ${w.temp_ext}°C | Umidade: ${w.umidade_ext}% | ${w.descricao}`;\nreturn msg;",
        "outputs": 1,
        "x": 800,
        "y": 650,
        "wires": [
            [
                "ui_text_weather",
                "e30c0d54db173f86"
            ]
        ]
    },
