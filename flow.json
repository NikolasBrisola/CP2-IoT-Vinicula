[
    {
        "id": "flow_vinicola",
        "type": "tab",
        "label": "Vinícola IoT - CP1",
        "disabled": false,
        "info": "Fluxo principal: MQTT → MySQL + Dashboard + OpenWeather"
    },
    {
        "id": "mqtt_broker_config",
        "type": "mqtt-broker",
        "name": "HiveMQ Broker",
        "broker": "broker.hivemq.com",
        "port": "1883",
        "clientid": "nodered_vinicola",
        "autoConnect": true,
        "usetls": false,
        "protocolVersion": "4",
        "keepalive": "60",
        "cleansession": true
    },
    {
        "id": "mysql_config",
        "type": "MySQLdatabase",
        "name": "vinicola_iot",
        "host": "127.0.0.1",
        "port": "3306",
        "db": "vinicola_iot",
        "tz": "America/Sao_Paulo"
    },
    {
        "id": "mqtt_in_telemetria",
        "type": "mqtt in",
        "z": "flow_vinicola",
        "name": "📡 MQTT Telemetria",
        "topic": "vinicola/cp1/telemetria",
        "qos": "1",
        "datatype": "json",
        "broker": "mqtt_broker_config",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
        "x": 130,
        "y": 200,
        "wires": [["parse_json"]]
    },
    {
        "id": "parse_json",
        "type": "json",
        "z": "flow_vinicola",
        "name": "Parse JSON",
        "property": "payload",
        "action": "obj",
        "pretty": false,
        "x": 340,
        "y": 200,
        "wires": [["insert_mysql", "gauge_temp", "gauge_umid", "gauge_luz", "chart_temp", "check_alerta"]]
    },
    {
        "id": "insert_mysql",
        "type": "function",
        "z": "flow_vinicola",
        "name": "🗄️ Preparar INSERT",
        "func": "// Monta a query parametrizada para evitar SQL injection\nconst d = msg.payload;\n\nmsg.topic = `INSERT INTO telemetria \n  (dispositivo, temperatura, umidade, luminosidade, alerta, msg_id, uptime_s) \n  VALUES (?, ?, ?, ?, ?, ?, ?)`;\n\nmsg.payload = [\n    d.dispositivo   || 'esp32_vinicola_cp1',\n    d.temperatura    || 0,\n    d.umidade        || 0,\n    d.luminosidade   || 0,\n    d.alerta         || 'ok',\n    d.msg_id         || 0,\n    d.uptime_s       || 0\n];\n\nreturn msg;",
        "outputs": 1,
        "x": 570,
        "y": 140,
        "wires": [["mysql_node"]]
    },
    {
        "id": "mysql_node",
        "type": "mysql",
        "z": "flow_vinicola",
        "name": "MySQL INSERT",
        "mydb": "mysql_config",
        "x": 780,
        "y": 140,
        "wires": [["debug_mysql"]]
    },
    {
        "id": "debug_mysql",
        "type": "debug",
        "z": "flow_vinicola",
        "name": "Debug MySQL",
        "active": true,
        "tosidebar": true,
        "complete": "true",
        "x": 970,
        "y": 140,
        "wires": []
    },
    {
        "id": "gauge_temp",
        "type": "function",
        "z": "flow_vinicola",
        "name": "🌡️ Extrair Temperatura",
        "func": "msg.payload = msg.payload.temperatura;\nmsg.topic = 'Temperatura (°C)';\nreturn msg;",
        "outputs": 1,
        "x": 590,
        "y": 240,
        "wires": [["ui_gauge_temp"]]
    },
    {
        "id": "gauge_umid",
        "type": "function",
        "z": "flow_vinicola",
        "name": "💧 Extrair Umidade",
        "func": "msg.payload = msg.payload.umidade;\nmsg.topic = 'Umidade (%)';\nreturn msg;",
        "outputs": 1,
        "x": 590,
        "y": 300,
        "wires": [["ui_gauge_umid"]]
    },
    {
        "id": "gauge_luz",
        "type": "function",
        "z": "flow_vinicola",
        "name": "☀️ Extrair Luminosidade",
        "func": "msg.payload = msg.payload.luminosidade;\nmsg.topic = 'Luminosidade';\nreturn msg;",
        "outputs": 1,
        "x": 600,
        "y": 360,
        "wires": [["ui_gauge_luz"]]
    },
    {
        "id": "chart_temp",
        "type": "function",
        "z": "flow_vinicola",
        "name": "📈 Dados p/ Chart",
        "func": "// Envia objeto com múltiplas séries para o chart\nmsg.payload = [\n  { \"topic\": \"Temperatura\", \"payload\": msg.payload.temperatura },\n  { \"topic\": \"Umidade\",     \"payload\": msg.payload.umidade }\n];\nreturn msg;",
        "outputs": 1,
        "x": 580,
        "y": 420,
        "wires": [["ui_chart_historico"]]
    },
    {
        "id": "check_alerta",
        "type": "switch",
        "z": "flow_vinicola",
        "name": "⚠️ Tem Alerta?",
        "property": "payload.alerta",
        "rules": [
            { "t": "neq", "v": "ok", "vt": "str" }
        ],
        "x": 570,
        "y": 480,
        "wires": [["notificar_alerta"]]
    },
    {
        "id": "notificar_alerta",
        "type": "function",
        "z": "flow_vinicola",
        "name": "🚨 Formatar Alerta",
        "func": "const d = msg.payload;\nmsg.payload = `⚠️ ALERTA VINÍCOLA\\n` +\n  `Dispositivo: ${d.dispositivo}\\n` +\n  `Tipo: ${d.alerta}\\n` +\n  `Temp: ${d.temperatura}°C | Umid: ${d.umidade}% | Luz: ${d.luminosidade}`;\nreturn msg;",
        "outputs": 1,
        "x": 800,
        "y": 480,
        "wires": [["ui_notificacao"]]
    },
    {
        "id": "ui_notificacao",
        "type": "ui_toast",
        "z": "flow_vinicola",
        "name": "Toast Alerta",
        "position": "top right",
        "displayTime": "5",
        "topic": "Alerta Vinícola",
        "outputs": 0,
        "x": 1010,
        "y": 480,
        "wires": []
    },
    {
        "id": "inject_openweather",
        "type": "inject",
        "z": "flow_vinicola",
        "name": "⏱️ A cada 10 min",
        "repeat": "600",
        "crontab": "",
        "once": true,
        "onceDelay": "5",
        "topic": "",
        "x": 150,
        "y": 600,
        "wires": [["http_openweather"]]
    },
    {
        "id": "http_openweather",
        "type": "http request",
        "z": "flow_vinicola",
        "name": "🌤️ OpenWeather API",
        "method": "GET",
        "ret": "obj",
        "paytoqs": "ignore",
        "url": "https://api.openweathermap.org/data/2.5/weather?q=Sao+Paulo,BR&appid=SUA_API_KEY&units=metric&lang=pt_br",
        "x": 400,
        "y": 600,
        "wires": [["parse_weather"]]
    },
    {
        "id": "parse_weather",
        "type": "function",
        "z": "flow_vinicola",
        "name": "📦 Parse Weather",
        "func": "// Extrai dados relevantes da resposta do OpenWeather\nconst w = msg.payload;\n\nif (!w || !w.main) {\n    node.warn('Resposta inválida do OpenWeather');\n    return null;\n}\n\nmsg.weather = {\n    cidade:      w.name || 'Sao Paulo',\n    temp_ext:    w.main.temp,\n    umidade_ext: w.main.humidity,\n    descricao:   w.weather[0].description || ''\n};\n\n// Prepara INSERT no MySQL\nmsg.topic = `INSERT INTO clima_externo \n  (cidade, temp_externa, umidade_ext, descricao) \n  VALUES (?, ?, ?, ?)`;\n\nmsg.payload = [\n    msg.weather.cidade,\n    msg.weather.temp_ext,\n    msg.weather.umidade_ext,\n    msg.weather.descricao\n];\n\nreturn msg;",
        "outputs": 1,
        "x": 620,
        "y": 600,
        "wires": [["mysql_weather", "ui_weather_display"]]
    },
    {
        "id": "mysql_weather",
        "type": "mysql",
        "z": "flow_vinicola",
        "name": "MySQL Weather",
        "mydb": "mysql_config",
        "x": 830,
        "y": 570,
        "wires": [[]]
    },
    {
        "id": "ui_weather_display",
        "type": "function",
        "z": "flow_vinicola",
        "name": "🌡️ Weather p/ Dashboard",
        "func": "const w = msg.weather;\nmsg.payload = `${w.cidade}: ${w.temp_ext}°C | ${w.umidade_ext}% | ${w.descricao}`;\nreturn msg;",
        "outputs": 1,
        "x": 850,
        "y": 640,
        "wires": [["ui_text_weather"]]
    },
    {
        "id": "ui_gauge_temp",
        "type": "ui_gauge",
        "z": "flow_vinicola",
        "name": "Gauge Temperatura",
        "group": "dashboard_group",
        "order": 1,
        "width": 4,
        "height": 4,
        "gtype": "gage",
        "title": "Temperatura °C",
        "label": "°C",
        "format": "{{value}}",
        "min": 0,
        "max": 40,
        "colors": ["#3498db", "#2ecc71", "#e74c3c"],
        "seg1": "12",
        "seg2": "20",
        "x": 830,
        "y": 240,
        "wires": []
    },
    {
        "id": "ui_gauge_umid",
        "type": "ui_gauge",
        "z": "flow_vinicola",
        "name": "Gauge Umidade",
        "group": "dashboard_group",
        "order": 2,
        "width": 4,
        "height": 4,
        "gtype": "gage",
        "title": "Umidade %",
        "label": "%",
        "format": "{{value}}",
        "min": 0,
        "max": 100,
        "colors": ["#e74c3c", "#2ecc71", "#3498db"],
        "seg1": "55",
        "seg2": "75",
        "x": 810,
        "y": 300,
        "wires": []
    },
    {
        "id": "ui_gauge_luz",
        "type": "ui_gauge",
        "z": "flow_vinicola",
        "name": "Gauge Luminosidade",
        "group": "dashboard_group",
        "order": 3,
        "width": 4,
        "height": 4,
        "gtype": "gage",
        "title": "Luminosidade",
        "label": "lux",
        "format": "{{value}}",
        "min": 0,
        "max": 4095,
        "colors": ["#2ecc71", "#f39c12", "#e74c3c"],
        "seg1": "300",
        "seg2": "500",
        "x": 830,
        "y": 360,
        "wires": []
    },
    {
        "id": "ui_chart_historico",
        "type": "ui_chart",
        "z": "flow_vinicola",
        "name": "Chart Histórico",
        "group": "dashboard_group",
        "order": 4,
        "width": 12,
        "height": 6,
        "label": "Histórico Temp/Umidade",
        "chartType": "line",
        "legend": "true",
        "xformat": "HH:mm:ss",
        "interpolate": "linear",
        "nodata": "Aguardando dados...",
        "dot": false,
        "ymin": "0",
        "ymax": "100",
        "removeOlder": "1",
        "removeOlderUnit": "3600",
        "x": 820,
        "y": 420,
        "wires": [[]]
    },
    {
        "id": "ui_text_weather",
        "type": "ui_text",
        "z": "flow_vinicola",
        "name": "Clima Externo",
        "group": "dashboard_group",
        "order": 5,
        "width": 12,
        "height": 1,
        "label": "Clima Externo",
        "format": "{{msg.payload}}",
        "x": 1060,
        "y": 640,
        "wires": []
    },
    {
        "id": "dashboard_group",
        "type": "ui_group",
        "name": "Monitoramento Vinícola",
        "tab": "dashboard_tab",
        "order": 1,
        "disp": true,
        "width": "12"
    },
    {
        "id": "dashboard_tab",
        "type": "ui_tab",
        "name": "Vinícola CP1",
        "icon": "fa-wine-glass",
        "order": 1
    }
]
